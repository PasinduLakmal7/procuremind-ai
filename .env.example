# ==============================================================================
# Procurement Intelligence Platform — Environment Variables Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Global Environment
ENVIRONMENT=development
DEBUG=true

# Gateway Configuration
GATEWAY_PORT=80

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache
REDIS_URL=redis://redis:6379/0

# RabbitMQ Event Broker
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_QUOTATIONS=procurement-quotations

# Authentication & Security
# WARNING: Change this key in production to a cryptographically secure 64-char string!
JWT_SECRET_KEY=change-this-secure-random-jwt-secret-key-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Service Ports (Local development standalone)
IDENTITY_SERVICE_PORT=8001
PROCUREMENT_SERVICE_PORT=8002
SUPPLIER_SERVICE_PORT=8003
DOCUMENT_SERVICE_PORT=8004
AI_ORCHESTRATOR_SERVICE_PORT=8005
RISK_SERVICE_PORT=8006
OPTIMIZATION_SERVICE_PORT=8007
FRONTEND_PORT=5173

