# ==============================================================================
# Procurement Intelligence Platform — .gitignore
# ==============================================================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# Python & Virtual Environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/

# Build & Distribution Artifacts
build/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
frontend/procurement-dashboard/dist/
frontend/procurement-dashboard/build/
frontend/procurement-dashboard/.eslintcache

# Local Databases & Persistent Storage
*.db
*.sqlite
*.sqlite3
postgres_data/
rabbitmq_data/
redis_data/
minio_data/
data/
uploads/

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Logs & Temporary Files
*.log
tmp/
temp/

